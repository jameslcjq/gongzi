{
  "name": "salary-system-electron",
  "version": "0.1.0",
  "private": true,
  "productName": "老九的工资系统",
  "description": "独立版工资系统 Electron 桌面程序",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "dist": "npm run build && electron-builder --win nsis",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit"
  },
  "build": {
    "appId": "com.laojiu.gzxt",
    "productName": "老九的工资系统",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../docs/data",
        "to": "docs/data",
        "filter": [
          "worksheets-retained.json"
        ]
      },
      {
        "from": "installer/resources/lookup-seeds.json",
        "to": "lookup-seeds.json"
      }
    ],
    "asarUnpack": [
      "node_modules/sqlite3/**"
    ],
    "win": {
      "icon": "installer/assets/app-icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "老九的工资系统",
      "artifactName": "老九的工资系统安装包-${version}.${ext}",
      "installerIcon": "installer/assets/app-icon.ico",
      "uninstallerIcon": "installer/assets/app-icon.ico",
      "include": "installer/installer.nsh"
    }
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "chokidar": "^5.0.0",
    "element-plus": "^2.13.6",
    "pdf-lib": "^1.17.1",
    "sqlite3": "^6.0.1",
    "vue": "^3.5.31",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.5",
    "electron": "^30.5.1",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.21.5",
    "typescript": "^5.7.3",
    "vite": "^5.4.21",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vue-tsc": "^2.2.0"
  }
}
