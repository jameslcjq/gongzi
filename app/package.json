{
  "name": "salary-system-electron",
  "version": "1.24.0",
  "private": true,
  "productName": "老九的工资系统",
  "description": "独立版工资系统 Electron 桌面程序",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "clean:build": "node scripts/clean-build.mjs",
    "build:helper": "dotnet publish ../tools/laojiu-automation-helper/laojiu-automation-helper.csproj -c Release -r win-x64 --self-contained true -p:PublishSingleFile=true -p:PublishReadyToRun=false -p:IncludeNativeLibrariesForSelfExtract=true -o native",
    "build": "npm run clean:build && npm run build:helper && vue-tsc --noEmit && vite build",
    "dist": "npm run build && electron-builder --win nsis",
    "dist:copy2": "npm run build && electron-builder --win nsis --config installer/electron-builder.copy2.yml",
    "dist:runner": "set APP_FLAVOR=runner&& npm run build && electron-builder --win nsis --config installer/electron-builder.runner.yml",
    "dist:runner:copy2": "set APP_FLAVOR=runner&& npm run build && electron-builder --win nsis --config installer/electron-builder.runner.copy2.yml",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:scripts": "node scripts/check-injection-scripts.mjs",
    "test:monthly-payroll-reconciliation": "node scripts/run-monthly-payroll-reconciliation-test.mjs",
    "test:monthly-payroll-voucher": "node scripts/run-monthly-payroll-voucher-sheet-test.mjs"
  },
  "build": {
    "appId": "com.laojiu.gzxt",
    "productName": "老九的工资系统",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../docs/data",
        "to": "docs/data",
        "filter": [
          "worksheets-retained.json"
        ]
      },
      {
        "from": "installer/resources",
        "to": ".",
        "filter": [
          "lookup-seeds.json",
          "license_public_key.pem"
        ]
      },
      {
        "from": "public/templates",
        "to": "templates",
        "filter": [
          "*"
        ]
      },
      {
        "from": "native",
        "to": "native",
        "filter": [
          "laojiu-automation-helper.exe"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/sqlite3/**"
    ],
    "win": {
      "icon": "installer/assets/app-icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "老九的工资系统",
      "artifactName": "老九的工资系统安装包-${version}.${ext}",
      "installerIcon": "installer/assets/app-icon.ico",
      "uninstallerIcon": "installer/assets/app-icon.ico",
      "include": "installer/installer.nsh"
    }
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "chokidar": "^5.0.0",
    "element-plus": "^2.13.6",
    "imapflow": "^1.3.3",
    "jszip": "^3.10.1",
    "mailparser": "^3.9.8",
    "pdf-lib": "^1.17.1",
    "sqlite3": "^6.0.1",
    "vue": "^3.5.31",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@vitejs/plugin-vue": "^6.0.5",
    "electron": "^30.5.1",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.21.5",
    "jquery-easyui": "^1.5.21",
    "typescript": "^5.7.3",
    "vite": "^5.4.21",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.1.8",
    "vue-tsc": "^2.2.0"
  }
}
